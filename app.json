{
  "expo": {
    "name": "CabzEmployee",
    "slug": "cabz-employee-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cabzemployee",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cabz.employee",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to set your pickup point.",
        "NSLocationAlwaysUsageDescription": "We need your location to track your ride."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.cabz.employee",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CabzEmployee to use your location."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eaccaa72-6c70-4f77-a8a0-dd83bc2e4c16"
      }
    }
  }
}
